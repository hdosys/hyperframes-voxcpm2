+void VoxCPM2Runtime::set_n_threads(int n_threads) {
+    if (n_threads < 1) {
+        return;
+    }
+    if (base_lm.ctx) {
+        llama_set_n_threads(base_lm.ctx, n_threads, n_threads);
+    }
+    if (backend && ggml_backend_is_cpu(backend)) {
+        ggml_backend_cpu_set_n_threads(backend, n_threads);
+    }
